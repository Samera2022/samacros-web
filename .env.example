# RSA Private Key (PEM 格式)
# 生成命令: openssl genrsa -out private.pem 2048
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
-----END PRIVATE KEY-----"

# Cloudflare KV Namespace ID
# 获取方式: wrangler kv:namespace create ORDER_DB
ORDER_DB_ID="your_kv_namespace_id_here"

# 可选: 管理员令牌
ADMIN_TOKEN="your_secure_admin_token_here"
